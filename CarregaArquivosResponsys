# =========================
# LISTAR BUCKET (CACHE)
# =========================
def listar_arquivos_bucket():
    objetos = set()
    start = None

    while True:
        response = object_storage.list_objects(
            namespace_name=namespace,
            bucket_name=bucket_name,
            start=start
        )

        for obj in response.data.objects:
            objetos.add(obj.name)

        if response.data.next_start_with:
            start = response.data.next_start_with
        else:
            break

    return objetos


arquivos_no_bucket = listar_arquivos_bucket()
print(f"Arquivos já no bucket: {len(arquivos_no_bucket)}")


# =========================
# UPLOAD COM RETRY
# =========================
def upload_com_retry(file_path, object_name, tentativas=3):
    for tentativa in range(1, tentativas + 1):
        try:
            with open(file_path, "rb") as f:
                object_storage.put_object(
                    namespace_name=namespace,
                    bucket_name=bucket_name,
                    object_name=object_name,
                    put_object_body=f
                )
            return True

        except Exception as e:
            print(f"[RETRY {tentativa}] {object_name}: {e}")
            time.sleep(2)

    return False


# =========================
# PROCESSAMENTO PARA THREAD
# =========================
def processar_arquivo(file_path, filename):
    try:
        # filtro por data
        if hoje_str not in filename:
            return

        # valida bucket
        if filename in arquivos_no_bucket:
            print(f"[SKIP] {filename}")
            return

        inicio = time.time()

        sucesso = upload_com_retry(file_path, filename)

        if not sucesso:
            print(f"[ERRO FINAL] {filename}")
            return

        tempo = time.time() - inicio

        print(f"[ENVIADO] {filename} ({tempo:.2f}s)")

        # atualiza cache
        arquivos_no_bucket.add(filename)

    except Exception as e:
        print(f"[ERRO THREAD] {filename}: {e}")


# =========================
# EXECUÇÃO PARALELA
# =========================
def enviar_diretorio(local_directory):
    try:
        arquivos = [
            (os.path.join(local_directory, f), f)
            for f in os.listdir(local_directory)
            if os.path.isfile(os.path.join(local_directory, f))
        ]

        with ThreadPoolExecutor(max_workers=8) as executor:
            executor.map(lambda x: processar_arquivo(*x), arquivos)

    except Exception as e:
        print(f"[ERRO DIRETÓRIO] {local_directory}: {e}")


